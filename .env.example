# ZS Builder external AI providers. Configure one or more keys on the backend.
# Never expose these values with NEXT_PUBLIC_ prefixes.

# Global controls
ZS_AI_EXTERNAL_ENABLED=true
ZS_AI_PROVIDER_ORDER=openrouter,openai,anthropic,google,deepseek,qwen,mistral,llama
ZS_AI_TIMEOUT_MS=22000
# true usa openrouter/free por padrao quando OPENROUTER_API_KEY existir.
ZS_AI_FREE_MODE=true

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FREE=openrouter/free
OPENROUTER_MODEL_RAPIDO=openrouter/free
OPENROUTER_MODEL_EQUILIBRADO=openrouter/free
OPENROUTER_MODEL_AVANCADO=openrouter/free
OPENROUTER_MODEL_CODE=openrouter/free

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_RAPIDO=gpt-4o-mini
OPENAI_MODEL_EQUILIBRADO=gpt-4.1-mini
OPENAI_MODEL_AVANCADO=gpt-4.1
OPENAI_MODEL_CODE=gpt-4.1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_RAPIDO=claude-3-5-haiku-latest
ANTHROPIC_MODEL_EQUILIBRADO=claude-sonnet-4-5
ANTHROPIC_MODEL_AVANCADO=claude-opus-4-1
ANTHROPIC_MODEL_CODE=claude-sonnet-4-5

# Google Gemini
GOOGLE_GEMINI_API_KEY=
GOOGLE_MODEL_RAPIDO=gemini-2.5-flash
GOOGLE_MODEL_EQUILIBRADO=gemini-2.5-pro
GOOGLE_MODEL_AVANCADO=gemini-2.5-pro
GOOGLE_MODEL_CODE=gemini-2.5-pro

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_RAPIDO=deepseek-chat
DEEPSEEK_MODEL_EQUILIBRADO=deepseek-chat
DEEPSEEK_MODEL_AVANCADO=deepseek-reasoner
DEEPSEEK_MODEL_CODE=deepseek-chat

# Qwen / DashScope OpenAI-compatible mode
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_RAPIDO=qwen-turbo
QWEN_MODEL_EQUILIBRADO=qwen-plus
QWEN_MODEL_AVANCADO=qwen-max
QWEN_MODEL_CODE=qwen-coder-plus

# Llama via any OpenAI-compatible endpoint, for example local Ollama or a hosted Llama gateway
LLAMA_API_KEY=
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_MODEL_RAPIDO=llama-3.2-3b-instruct
LLAMA_MODEL_EQUILIBRADO=llama-3.3-70b-instruct
LLAMA_MODEL_AVANCADO=llama-3.3-70b-instruct
LLAMA_MODEL_CODE=codellama

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL_RAPIDO=mistral-small-latest
MISTRAL_MODEL_EQUILIBRADO=mistral-medium-latest
MISTRAL_MODEL_AVANCADO=mistral-large-latest
MISTRAL_MODEL_CODE=codestral-latest
